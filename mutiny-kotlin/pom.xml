<project xmlns="http://maven.apache.org/POM/4.1.0">
    <modelVersion>4.1.0</modelVersion>
    <parent><groupId>com.guicedee</groupId><artifactId>kotlin-parent</artifactId><version>2.6.0</version></parent>
    <groupId>com.guicedee.modules.services</groupId><artifactId>mutiny-kotlin</artifactId>
    <name>Mutiny Kotlin coroutine extensions JPMS wrapper</name>
    <description>Unrelocated upstream coroutine adapters, excluding split-package convenience functions and their dependent builder.</description>
    <properties><ignore.moditect>false</ignore.moditect><maven.jar.forceCreation>true</maven.jar.forceCreation></properties>
    <dependencies>
        <dependency><groupId>io.smallrye.reactive</groupId><artifactId>mutiny-kotlin</artifactId><optional>true</optional>
            <exclusions><exclusion><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core</artifactId></exclusion></exclusions>
        </dependency>
        <dependency><groupId>io.smallrye.reactive</groupId><artifactId>mutiny</artifactId></dependency>
        <dependency><groupId>org.jetbrains.kotlin</groupId><artifactId>kotlin-stdlib</artifactId></dependency>
        <dependency><groupId>org.jetbrains.kotlinx</groupId><artifactId>kotlinx-coroutines-core-jvm</artifactId></dependency>
    </dependencies>
    <build><plugins>
        <plugin><groupId>com.guicedee.maven</groupId><artifactId>flatten-maven-plugin</artifactId></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-antrun-plugin</artifactId></plugin>
        <plugin><groupId>org.jetbrains.dokka</groupId><artifactId>dokka-maven-plugin</artifactId></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId>
            <configuration>
                <relocations combine.self="override"/><createDependencyReducedPom>false</createDependencyReducedPom>
                <artifactSet><includes><include>io.smallrye.reactive:mutiny-kotlin</include></includes></artifactSet>
                <filters><filter><artifact>io.smallrye.reactive:mutiny-kotlin</artifact><excludes>
                    <exclude>io/smallrye/mutiny/*.class</exclude>
                    <exclude>io/smallrye/mutiny/coroutines/MultiBuilders*.class</exclude>
                </excludes></filter></filters>
            </configuration>
            <executions><execution><id>shade</id><phase>package</phase><goals><goal>shade</goal></goals></execution></executions>
        </plugin>
        <plugin><groupId>org.moditect</groupId><artifactId>moditect-maven-plugin</artifactId></plugin>
    </plugins></build>
</project>
